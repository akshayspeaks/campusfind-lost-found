# CampusFind Environment Configuration

# Server
PORT=3000
NODE_ENV=development
# Set true to disable hot-module replacement during Vite development.
DISABLE_HMR=false

# Authentication & Security
# MUST be set to a high-entropy secret (>= 32 characters) in production
JWT_SECRET=campusfind-dev-supersecret-jwt-key-change-in-production
JWT_REFRESH_SECRET=campusfind-dev-refresh-secret-change-in-production
# HMAC key for verification-detail audit hashes. Generate a distinct random secret (at least 32 characters) for production.
VERIFICATION_DETAIL_AUDIT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated for multiple allowed origins)
# Example: https://campusfind.university.edu,https://admin.campusfind.edu
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=15

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880

# Database
# Local SQLite path (default for development and testing)
DATABASE_PATH=./data/campusfind.sqlite

# Production Database (PostgreSQL)
# Required in production and must be a postgres:// or postgresql:// URL.
# When set in development/test, CampusFind uses PostgreSQL with connection pooling.
DATABASE_URL=

# DANGEROUS: only uncomment and set this to YES when running the PostgreSQL
# integration script against a disposable local database whose name has a
# whole `test` segment (for example campusfind_test). Never set in production.
# ALLOW_DESTRUCTIVE_POSTGRES_TESTS=YES

# Persistent Object Storage (Cloudflare R2 / AWS S3)
# When set, image uploads stream directly to persistent object storage instead of local disk
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_PREFIX=
